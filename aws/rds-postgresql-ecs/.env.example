# PostgreSQL Monitoring User Credentials
# REQUIRED when CREATE_MONITORING_USER=false (see quick_setup.md)
# Create this user manually in your database first
PG_USERNAME=otel_monitor
PG_PASSWORD=<your-monitoring-password>

# PostgreSQL Connection (for standalone usage, not needed for quick_setup.sh)
PG_ENDPOINT=<your-rds-endpoint>
PG_PORT=5432
# Select the application database. Exclude EVERY other non-template database below.
PG_DATABASE=postgres
PG_EXCLUDE_DATABASES=[rdsadmin,template0,template1]
# Opt in only after reviewing SQL literal/PII access and log retention.
PG_CAPTURE_QUERY_TEXT=false

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your-access-key>
AWS_SECRET_ACCESS_KEY=<your-secret-key>
# RDS Instance Identifier (not the endpoint, just the identifier)
RDS_INSTANCE_ID=<your-rds-instance-id>

# Last9 Configuration
# Get these from Last9 Integrations page
LAST9_OTLP_ENDPOINT=YOUR_LAST9_ENDPOINT
LAST9_AUTH_HEADER=Basic <your-base64-encoded-credentials>

# Environment name for tagging and labeling (use any value: prod, staging, dev, uat, Dev, PROD, etc.)
ENVIRONMENT=dev
