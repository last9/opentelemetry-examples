# Last9 organization slug (from app.last9.io/v2/organizations/<org>/...)
LAST9_ORG=

# Short-lived access token from POST /api/v4/oauth/access_token
# Needs write scope (and delete to tear down). Admin org role required for writes.
LAST9_ACCESS_TOKEN=

# Optional: override API host (default https://app.last9.io)
# LAST9_HOST=https://app.last9.io

# Remote MCP server to register (must be HTTPS)
MCP_NAME=payments
MCP_URL=https://mcp.example.com/mcp
# Quote values that contain spaces (required when sourcing .env)
MCP_AUTH_HEADER='Bearer <mcp_credential>'

# Knowledge topic
TOPIC_ID=payments-incident-playbook
TOPIC_NAME=Payments incident playbook
